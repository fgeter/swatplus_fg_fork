# Ubuntu container for testing SWAT+ gfortran builds (esp. STATIC linking, which Arch can't do
# because it ships no libgfortran.a/libgomp.a). Based on the .devcontainer/Dockerfile, and like it
# also carries the Intel oneAPI Fortran compiler (ifx) so the same image can serve gfortran-vs-ifx
# comparisons.
#
# 24.04 "Noble" ships gfortran 13 (vs 22.04's gfortran 11.4). gfortran 13 has the real
# -static-libquadmath option, so mostly-static (SWAT_STATIC=libs) no longer needs the
# --whole-archive libquadmath workaround; and its newer libgfortran/glibc are worth re-testing
# against fully-static (SWAT_STATIC=full), which segfaulted under 22.04/gfortran 11.
#
# Build:  docker build -f docker/Dockerfile.ubuntu -t swatplus-ubuntu .
# Use:    docker run --rm -it --user $(id -u):$(id -g) -v "$PWD":/src -w /src swatplus-ubuntu \
#             bash docker/test_static_build.sh
#     (add -e SWAT_STATIC=full to test the fully-static mode)
#     The script builds Release -O3 -march=x86-64-v3 -- a portable AVX2/FMA baseline (Intel
#     Haswell+ 2013, AMD Excavator+ / all Zen 2015+) rather than the -march=native default, since
#     this binary is meant to run on hosts other than the build machine. Override with
#     -e SWAT_MARCH=x86-64-v2 (older CPUs) or -e SWAT_MARCH=native (local benchmarking only).
#   --user $(id -u):$(id -g) makes the container write host files (build-ubuntu/) as YOU, not root,
#   so no `sudo rm` is needed to clean up afterward. The scripts set HOME=/tmp (writable by any UID),
#   so running as a non-root/passwd-less user works. Drop --user only if a step needs to apt-install
#   at runtime (this image installs everything at build time, so it isn't needed).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# build-essential -> gcc/make + libc6-dev (provides static libc.a and libgomp.a)
# gfortran        -> gfortran + static libgfortran.a / libquadmath.a (Ubuntu ships these; Arch does not)
# cmake, git      -> configure/build + version-tag detection
# gdb             -> debugging (matches the devcontainer)
# file            -> verify the resulting binary is statically linked
# wget, gpg       -> fetch/dearmor Intel's repo key below
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gfortran \
        cmake \
        git \
        gdb \
        file \
        ca-certificates \
        wget \
        gpg \
    && rm -rf /var/lib/apt/lists/*

# Sanity: fail the image build if the static Fortran/OpenMP runtimes are missing (the whole point).
RUN set -e; \
    for lib in libgfortran.a libgomp.a libc.a; do \
        find /usr -name "$lib" -print -quit | grep -q . \
            && echo "OK: found $lib" \
            || { echo "ERROR: static lib $lib missing"; exit 1; }; \
    done

# --- Intel oneAPI Fortran compiler (ifx) ---------------------------------------------------------
# Mirrors .devcontainer/Dockerfile steps 2-4. The repo line is "all main" (distro-agnostic), so the
# same recipe that works on the devcontainer's 22.04 Jammy base works here on 24.04 Noble.
RUN wget -O- https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
    | gpg --dearmor \
    | tee /usr/share/keyrings/oneapi-archive-keyring.gpg > /dev/null

RUN echo "deb [signed-by=/usr/share/keyrings/oneapi-archive-keyring.gpg] https://apt.repos.intel.com/oneapi all main" \
    > /etc/apt/sources.list.d/oneAPI.list

RUN apt-get update && apt-get install -y --no-install-recommends \
        intel-oneapi-compiler-fortran \
    && rm -rf /var/lib/apt/lists/*

# The devcontainer only appends setvars.sh to /etc/bash.bashrc, which bash reads for INTERACTIVE
# non-login shells. Our test scripts run non-interactively (`bash docker/test_static_build.sh`),
# so that alone would leave ifx off PATH here. Keep the bashrc line for `docker run -it` use, but
# also set the env directly so non-interactive runs find ifx and its runtime libs. The "latest"
# symlink avoids hardcoding a version (e.g. 2025.0), which would silently break on image rebuild.
RUN echo "source /opt/intel/oneapi/setvars.sh" >> /etc/bash.bashrc
ENV PATH=/opt/intel/oneapi/compiler/latest/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/intel/oneapi/compiler/latest/lib:/opt/intel/oneapi/compiler/latest/lib/clang/latest/lib/x86_64-unknown-linux-gnu:$LD_LIBRARY_PATH

# Sanity: ifx must be on PATH and runnable in a NON-interactive shell (the mode our scripts use).
RUN bash -c 'ifx --version' && echo "OK: ifx reachable non-interactively"

WORKDIR /src
CMD ["bash"]
